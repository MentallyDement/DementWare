local _G_ESP = {
    Enabled = false,
    Name = true,
    Level = true,
    Bounty = true,
    Distance = true,
    HP = true,
    Highlight = false,
    TextSize = 12
}

local espObjects = {}

local function removeESP(targetP)
    if espObjects[targetP] then
        pcall(function()
            if espObjects[targetP].gui then espObjects[targetP].gui:Destroy() end
            if espObjects[targetP].highlight then espObjects[targetP].highlight:Destroy() end
        end)
        espObjects[targetP] = nil
    end
end

local function createESP(targetP)
    if not targetP or targetP == lp then return end
    local char = targetP.Character
    if not char then return end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head then return end

    removeESP(targetP)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DementESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 220, 0, 80)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.Parent = head

    local text = Instance.new("TextLabel", billboard)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.TextSize = _G_ESP.TextSize
    text.RichText = true
    text.Font = Enum.Font.SourceSansBold
    text.TextStrokeTransparency = 0
    text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.Text = targetP.Name

    local highlight = nil
    if _G_ESP.Highlight then
        highlight = Instance.new("Highlight")
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = Color3.fromRGB(255, 50, 50)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.Parent = char
    end

    espObjects[targetP] = {gui = billboard, label = text, highlight = highlight}
end

local function updateESP()
    if not _G_ESP.Enabled then
        for p in pairs(espObjects) do removeESP(p) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p \~= lp and p.Character then
            if not espObjects[p] then createESP(p) end
            local data = espObjects[p]
            if data and data.label then
                local char = p.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local lines = {}
                if _G_ESP.Name then table.insert(lines, p.DisplayName) end
                if _G_ESP.HP and hum then table.insert(lines, string.format("HP: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))) end
                if _G_ESP.Distance and hrp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (hrp.Position - lp.Character.HumanoidRootPart.Position).Magnitude
                    table.insert(lines, string.format("%dm", math.floor(d)))
                end
                data.label.Text = table.concat(lines, "\n")
                data.label.TextSize = _G_ESP.TextSize
            end
        else
            removeESP(p)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.25)
        pcall(updateESP)
    end
end)

Players.PlayerRemoving:Connect(removeESP)
lp.CharacterAdded:Connect(function()
    task.wait(1)
    for p in pairs(espObjects) do removeESP(p) end
end)

