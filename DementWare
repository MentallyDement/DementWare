local function getHRP(model)
    return model and model:FindFirstChild("HumanoidRootPart")
end

local function isAlive(model)
    if not model then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isEnemy(plr)
    if not plr or plr == lp then return false end
    local char = plr.Character
    if not char then return false end
    if char:GetAttribute("SafeZone") == true then return false end
    if char:GetAttribute("PvpDisabled") == true then return false end
    if char:GetAttribute("CombatProtected") == true then return false end
    if char:GetAttribute("PVP") == false then return false end
    return true
end

local function getFOVCenter()
    if SA.FOVMode == "Mouse" then
        return UserInputService:GetMouseLocation()
    end
    return camera.ViewportSize / 2
end

local function predicted(hrp)
    if not hrp then return nil end
    if not SA.Prediction then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or hrp.Velocity
    local ping = 0
    pcall(function()
        ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    ping = math.clamp(ping or 0, 0, 0.35)
    local factor = SA.PredAmt + ping
    if vel.Magnitude > 100 then factor = math.min(factor, 0.15) end
    return hrp.Position + (vel * factor)
end

local function isInAim(hrp, myHRP)
    if not hrp or not myHRP then return false end
    if SA.AimMode == "180" then
        local dir = (hrp.Position - myHRP.Position)
        if dir.Magnitude < 0.1 then return true end
        return myHRP.CFrame.LookVector:Dot(dir.Unit) > 0
    elseif SA.AimMode == "FOV" then
        local sp, onScreen = camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then return false end
        local center = getFOVCenter()
        return (Vector2.new(sp.X, sp.Y) - center).Magnitude <= SA.FOVRadius
    end
    return true -- 360
end

local function getClosestPlayer(myHRP)
    local best, bestDist = nil, SA.MaxRange
    for _, pl in ipairs(Players:GetPlayers()) do
        if isEnemy(pl) and pl.Character and isAlive(pl.Character) then
            local hrp = getHRP(pl.Character)
            if hrp and isInAim(hrp, myHRP) then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = pl
                end
            end
        end
    end
    return best
end

local function getClosestNPC(myHRP)
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    local best, bestDist = nil, SA.MaxRange
    for _, npc in ipairs(folder:GetChildren()) do
        if npc:IsA("Model") and isAlive(npc) then
            local hrp = getHRP(npc)
            if hrp and isInAim(hrp, myHRP) then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = npc
                end
            end
        end
    end
    return best
end

