task.spawn(function()
    while true do
        RunService.Stepped:Wait()
        if not FastAttackEnabled then continue end
        pcall(function()
            local myHRP = lp.Character and getHRP(lp.Character)
            if not (myHRP and RegisterHit and RegisterAttack) then return end

            local targets = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p \~= lp and p.Character and isAlive(p.Character) then
                    local hrp = getHRP(p.Character)
                    if hrp and (hrp.Position - myHRP.Position).Magnitude <= 100 then
                        table.insert(targets, p.Character)
                    end
                end
            end
            local enemies = workspace:FindFirstChild("Enemies")
            if enemies then
                for _, npc in ipairs(enemies:GetChildren()) do
                    if isAlive(npc) then
                        local hrp = getHRP(npc)
                        if hrp and (hrp.Position - myHRP.Position).Magnitude <= 100 then
                            table.insert(targets, npc)
                        end
                    end
                end
            end
            if #targets == 0 then return end
            local packed = {}
            for _, ch in ipairs(targets) do
                local part = ch:FindFirstChild("Head") or getHRP(ch)
                if part then table.insert(packed, {ch, part}) end
            end
            if #packed > 0 then
                RegisterAttack:FireServer(0)
                RegisterHit:FireServer(packed[1][2], packed)
            end
        end)
    end
end)

local function getClosestAny()
    local myHRP = lp.Character and getHRP(lp.Character)
    if not myHRP then return nil end
    local best, dist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p \~= lp and p.Character and isAlive(p.Character) then
            local hrp = getHRP(p.Character)
            if hrp then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < dist then dist = d; best = hrp end
            end
        end
    end
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, npc in ipairs(enemies:GetChildren()) do
            if isAlive(npc) then
                local hrp = getHRP(npc)
                if hrp then
                    local d = (hrp.Position - myHRP.Position).Magnitude
                    if d < dist then dist = d; best = hrp end
                end
            end
        end
    end
    return best
end

