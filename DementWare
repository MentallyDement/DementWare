local ESP = {
    Enabled  = false,
    Name     = true,
    HP       = true,
    Distance = true,
    Highlight= false,
    TextSize = 12
}

local espObjects = {}

local function removeESP(plr)
    if espObjects[plr] then
        pcall(function()
            if espObjects[plr].gui then espObjects[plr].gui:Destroy() end
            if espObjects[plr].hl then espObjects[plr].hl:Destroy() end
        end)
        espObjects[plr] = nil
    end
end

local function createESP(plr)
    if not plr or plr == lp then return end
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head") or getHRP(char)
    if not head then return end
    removeESP(plr)

    local bb = Instance.new("BillboardGui")
    bb.Name = "DementESP"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 200, 0, 70)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextSize = ESP.TextSize
    lbl.RichText = true
    lbl.Font = Enum.Font.GothamBold
    lbl.TextStrokeTransparency = 0
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Text = plr.DisplayName

    local hl = nil
    if ESP.Highlight then
        hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(239, 68, 68)
        hl.FillTransparency = 0.55
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
    end

    espObjects[plr] = {gui = bb, label = lbl, hl = hl}
end

task.spawn(function()
    while true do
        task.wait(0.2)
        if not ESP.Enabled then
            for p in pairs(espObjects) do removeESP(p) end
            continue
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p \~= lp and p.Character and isAlive(p.Character) then
                if not espObjects[p] then createESP(p) end
                local data = espObjects[p]
                if data and data.label then
                    local lines = {}
                    if ESP.Name then table.insert(lines, p.DisplayName) end
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if ESP.HP and hum then
                        table.insert(lines, string.format("HP: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth)))
                    end
                    local hrp = getHRP(p.Character)
                    local myHRP = lp.Character and getHRP(lp.Character)
                    if ESP.Distance and hrp and myHRP then
                        table.insert(lines, math.floor((hrp.Position - myHRP.Position).Magnitude) .. "m")
                    end
                    data.label.Text = table.concat(lines, "\n")
                    data.label.TextSize = ESP.TextSize
                end
            else
                removeESP(p)
            end
        end
    end
end)

