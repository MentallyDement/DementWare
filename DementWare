        else
            NPCPosition = nil
        end
    else
        NPCPosition = nil
    end
end)

-- Metatable hooks for Silent Aim
pcall(function()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    local oldIndex = mt.__index

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if (SilentAimPlayersEnabled or SilentAimNPCsEnabled) then
            local targetPos = PlayersPosition or NPCPosition
            if targetPos then
                if method == "FireServer" or method == "InvokeServer" then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = targetPos
                        elseif typeof(v) == "CFrame" then
                            args[i] = CFrame.new(targetPos)
                        end
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    mt.__index = newcclosure(function(self, key)
        if (SilentAimPlayersEnabled or SilentAimNPCsEnabled) and self == mouse and (key == "Hit" or key == "Target") then
            local targetPos = PlayersPosition or NPCPosition
            if targetPos then
                if key == "Hit" then return CFrame.new(targetPos) end
                if key == "Target" then
                    local t = getClosestPlayer(lp.Character and lp.Character:FindFirstChild("HumanoidRootPart"))
                    return t and t.Character and (t.Character:FindFirstChild("HumanoidRootPart") or t.Character:FindFirstChild("Head"))
                end
            end
        end
        return oldIndex(self, key)
    end)

    setreadonly(mt, true)
end)

