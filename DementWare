        else
            SA.NPCsPos = nil
        end
    else
        SA.NPCsPos = nil
    end
end)

-- Hooks fuertes
pcall(function()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)

    local oldNamecall = mt.__namecall
    local oldIndex   = mt.__index

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if (SA.Players or SA.NPCs) then
            local target = SA.PlayersPos or SA.NPCsPos
            if target then
                if method == "FireServer" or method == "InvokeServer" then
                    for i = 1, #args do
                        local v = args[i]
                        if typeof(v) == "Vector3" then
                            args[i] = target
                        elseif typeof(v) == "CFrame" then
                            args[i] = CFrame.new(target)
                        end
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    mt.__index = newcclosure(function(self, key)
        if (SA.Players or SA.NPCs) and self == mouse then
            local target = SA.PlayersPos or SA.NPCsPos
            if target then
                if key == "Hit" then
                    return CFrame.new(target)
                elseif key == "Target" then
                    local myHRP = lp.Character and getHRP(lp.Character)
                    local pl = myHRP and getClosestPlayer(myHRP)
                    if pl and pl.Character then
                        return getHRP(pl.Character) or pl.Character:FindFirstChild("Head")
                    end
                end
            end
        end
        return oldIndex(self, key)
    end)

    setreadonly(mt, true)
end)

