end)

local BunnyHopEnabled = false
local FLASH_IDS = {"17555632156","18461649274","1846163351","616006778","616010882","5403485593","5403491911"}
local function monitorBunnyHop(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if hum then
        hum.AnimationPlayed:Connect(function(track)
            if not BunnyHopEnabled then return end
            local animName = string.lower(track.Name)
            local id = track.Animation and track.Animation.AnimationId:match("%d+") or ""
            local isDash = string.find(animName, "dash") or string.find(animName, "flashstep") or table.find(FLASH_IDS, id)
            if isDash then
                task.spawn(function()
                    task.wait(0.05)
                    if hum and hum.FloorMaterial \~= Enum.Material.Air then
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end)
            end
        end)
    end
end
lp.CharacterAdded:Connect(monitorBunnyHop)
if lp.Character then monitorBunnyHop(lp.Character) end

